<Window
	x:Class="CodeJanitor.UI.Dialogs.Ai.AiCoverageOptionsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="AI Target Code Coverage Options"
	Width="480"
	Height="380"
	MinWidth="400"
	MinHeight="340"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Grid Background="#F8F9FA">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Header -->
		<Border
			Grid.Row="0"
			Padding="16,12"
			Background="#007ACC"
			BorderBrush="#005A9E"
			BorderThickness="0,0,0,1">
			<StackPanel>
				<TextBlock
					FontSize="15"
					FontWeight="Bold"
					Foreground="White"
					Text="🎯 AI Unit Test Generation: Target Coverage" />
				<TextBlock
					Margin="0,4,0,0"
					FontSize="12"
					FontStyle="Italic"
					Foreground="#D0E8FF"
					Text="{Binding TargetName}" />
			</StackPanel>
		</Border>

		<!-- Form Body -->
		<StackPanel Grid.Row="1" Margin="20,16,20,10">
			<!-- Target Coverage Percentage -->
			<TextBlock FontWeight="SemiBold" Text="Target Code Coverage (Branches &amp; Lines):" />
			<Grid Margin="0,6,0,12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="60" />
				</Grid.ColumnDefinitions>
				<Slider
					VerticalAlignment="Center"
					IsSnapToTickEnabled="True"
					Maximum="100"
					Minimum="50"
					TickFrequency="5"
					Value="{Binding TargetCoveragePercentage}" />
				<TextBlock
					Grid.Column="1"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="Bold"
					Foreground="#007ACC"
					Text="{Binding TargetCoveragePercentage, StringFormat='{}{0}%'}" />
			</Grid>

			<!-- Max Iterations -->
			<TextBlock FontWeight="SemiBold" Text="Maximum AI Refinement Iterations:" />
			<StackPanel Margin="0,4,0,12" Orientation="Horizontal">
				<TextBox
					Width="50"
					Height="26"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock
					Margin="10,0,0,0"
					VerticalAlignment="Center"
					FontStyle="Italic"
					Foreground="#57606A"
					Text="(Rounds of AI test generation targeting missing branches)" />
			</StackPanel>

			<!-- Framework & Mocking -->
			<Grid Margin="0,4,0,10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="16" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0">
					<TextBlock FontWeight="SemiBold" Text="Test Framework:" />
					<TextBox
						Height="26"
						Margin="0,4,0,0"
						VerticalContentAlignment="Center"
						Text="{Binding TestFramework, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>
				<StackPanel Grid.Column="2">
					<TextBlock FontWeight="SemiBold" Text="Mocking Library:" />
					<TextBox
						Height="26"
						Margin="0,4,0,0"
						VerticalContentAlignment="Center"
						Text="{Binding MockingLibrary, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>
			</Grid>
		</StackPanel>

		<!-- Actions -->
		<Border
			Grid.Row="2"
			Padding="16,12"
			Background="#ECEFF1"
			BorderBrush="#CFD8DC"
			BorderThickness="0,1,0,0">
			<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
				<Button
					Width="160"
					Height="30"
					Margin="0,0,8,0"
					Background="#007ACC"
					Command="{Binding StartCommand}"
					Content="🚀 Start Generation"
					FontWeight="SemiBold"
					Foreground="White"
					IsDefault="True" />
				<Button
					Width="90"
					Height="30"
					Command="{Binding CancelCommand}"
					Content="Cancel"
					IsCancel="True" />
			</StackPanel>
		</Border>
	</Grid>
</Window>
