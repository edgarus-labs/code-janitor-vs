<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodeJanitor.UI.Dialogs.Options">

    <!--
        Shared host template for any CompositeOptionsPageViewModel (Cleaning, Reorganizing,
        General, Navigation, etc.) - renders its Children stacked one below another on a single
        scrollable panel (each preceded by a bold section title using the child's Header), instead
        of separate Tools>Options tree nodes or tabs, so related settings stay grouped under one
        page and are all visible at once. WPF resolves this template for any derived view model
        type when no more specific template is registered for it.
    -->
    <DataTemplate DataType="{x:Type local:CompositeOptionsPageViewModel}">
        <ItemsControl ItemsSource="{Binding Children}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,11">
                        <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="14" Margin="0,0,0,7" />
                        <ContentPresenter Content="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
