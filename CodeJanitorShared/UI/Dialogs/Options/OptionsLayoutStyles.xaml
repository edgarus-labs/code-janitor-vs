<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared layout for every Options page, following the Windows UX Guide spacing
        conventions (https://learn.microsoft.com/windows/win32/uxguide/guidelines):
        11px between unrelated groups, 7px between related controls within a group,
        minimum 75px-wide buttons. Applied as implicit (TargetType-only) styles so every
        page picks them up automatically without touching individual controls; any
        explicit Margin/Style set locally on a control still wins over these defaults.
    -->

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Margin" Value="0,0,0,11" />
        <Setter Property="Padding" Value="9,7" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Margin" Value="0,0,11,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,4,7,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Multi-line text areas (file headers, third-party command expressions, etc.). -->
    <Style x:Key="TextBoxMultiLine" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="MinHeight" Value="120" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="Padding" Value="11,3" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Margin" Value="0,7,0,0" />
    </Style>

    <!--
        "Chip" style for the ToggleButton lists (e.g. Cleaning > Insert), wider than the default
        ToggleButton and using the current Windows accent/highlight color when checked, so it
        matches the native OS look-and-feel rather than a flat/cramped checkbox-like button.
    -->
    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Margin" Value="0,0,7,7" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="ChipBorder"
                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
