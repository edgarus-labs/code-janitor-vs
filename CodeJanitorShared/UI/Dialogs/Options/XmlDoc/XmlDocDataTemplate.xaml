<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:CodeJanitor.UI.Dialogs.Options.XmlDoc"
	xmlns:ui="clr-namespace:CodeJanitor.UI">
	<DataTemplate DataType="{x:Type local:XmlDocViewModel}">
		<StackPanel>
			<GroupBox Header="AI-Assisted XML Documentation">
				<StackPanel>
					<CheckBox
						Content="Enable AI-assisted XML documentation"
						IsChecked="{Binding AiXmlDocumentationEnabled}"
						ToolTip="Enables Add XMLDoc command and AI documentation generation." />

					<TextBlock Margin="0,8,0,0" Text="Endpoint URL" />
					<TextBox Text="{Binding AiXmlDocumentationEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Margin="0,6,0,0" Text="API key" />
					<PasswordBox ui:PasswordBoxAssistant.BindPassword="True" ui:PasswordBoxAssistant.BoundPassword="{Binding AiXmlDocumentationApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Margin="0,6,0,0" Text="API key header (Authorization / api-key / x-api-key)" />
					<TextBox Text="{Binding AiXmlDocumentationApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Margin="0,6,0,0" Text="Model or deployment name (optional)" />
					<TextBox Text="{Binding AiXmlDocumentationModel, UpdateSourceTrigger=PropertyChanged}" />

					<StackPanel Margin="0,6,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Timeout (seconds)" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Max methods/file" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxMethodsPerFile, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<Button
							Margin="12,0,0,0"
							Padding="10,2"
							Command="{Binding TestAiXmlDocumentationConnectionCommand}"
							Content="Test Connection" />
					</StackPanel>

					<StackPanel Margin="0,6,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Max parallel files" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxParallelFiles, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right"
							ToolTip="Number of files processed concurrently during Add XMLDoc (default 4)." />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Minimum context window (tokens)"
							ToolTip="Recommended context size for the model to reliably process a full method's context (default 131072). For local endpoints (e.g. Ollama, llama.cpp), the actual context size must usually still be configured on the server itself (e.g. Ollama Modelfile 'PARAMETER num_ctx'); the OpenAI-compatible chat API does not let clients set it directly." />
						<TextBox
							Width="64"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationContextWindowTokens, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
					</StackPanel>

					<CheckBox
						Margin="0,8,0,0"
						Content="Preview AI XMLDoc changes before applying per file"
						IsChecked="{Binding AiXmlDocumentationPreviewChanges}" />
					<CheckBox Content="Allow deterministic fallback when AI response fails" IsChecked="{Binding AiXmlDocumentationAllowDeterministicFallback}" />

					<StackPanel Margin="0,6,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Max requests/run" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxRequestsPerCleanup, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Max input chars/method" />
						<TextBox
							Width="64"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxInputCharsPerMethod, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
					</StackPanel>

					<StackPanel Margin="0,6,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Max output tokens/request" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxTokensPerRequest, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Max estimated tokens/run" />
						<TextBox
							Width="64"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxEstimatedTokensPerCleanup, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Global timeout (s)" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationGlobalTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
					</StackPanel>

					<CheckBox
						Margin="0,8,0,0"
						Content="Ignore [GeneratedCode]/[CompilerGenerated] methods"
						IsChecked="{Binding AiXmlDocumentationIgnoreGeneratedCode}" />
					<CheckBox Content="Ignore [Obsolete] methods" IsChecked="{Binding AiXmlDocumentationIgnoreObsolete}" />
					<CheckBox Content="Ignore unit test methods (Fact/Theory/TestMethod/etc.)" IsChecked="{Binding AiXmlDocumentationIgnoreTestMethods}" />
					<TextBlock Margin="0,6,0,0" Text="Ignore regex (full member path Namespace.Type.Method)" />
					<TextBox Text="{Binding AiXmlDocumentationIgnorePattern, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock
						Margin="0,8,0,0"
						FontStyle="Italic"
						Text="{Binding AiXmlDocumentationConnectionStatus}"
						TextWrapping="Wrap" />
				</StackPanel>
			</GroupBox>
			<GroupBox Margin="0,8,0,0" Header="AI Unit Test Generation">
				<StackPanel>
					<StackPanel Margin="0,4,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Test Framework (xUnit / NUnit / MSTest)" />
						<TextBox
							Width="80"
							Margin="8,0,0,0"
							Text="{Binding AiTestFramework, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock
							Margin="16,0,0,0"
							VerticalAlignment="Center"
							Text="Mocking Library (Moq / NSubstitute)" />
						<TextBox
							Width="80"
							Margin="8,0,0,0"
							Text="{Binding AiMockingLibrary, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
				</StackPanel>
			</GroupBox>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
