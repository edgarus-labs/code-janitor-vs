<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cnv="clr-namespace:CodeJanitor.UI.Converters"
	xmlns:local="clr-namespace:CodeJanitor.UI.Dialogs.Options.Switching"
	xmlns:p="clr-namespace:CodeJanitor.Properties">
	<DataTemplate DataType="{x:Type local:SwitchingViewModel}">
		<StackPanel>
			<TextBlock Margin="5,5,5,0" Text="{x:Static p:Resources.SetsOfRelatedFileExtensionsExCppH}" />
			<TextBox Style="{DynamicResource TextBoxMultiLine}" Text="{Binding RelatedFileExtensionsExpression, Converter={x:Static cnv:StringReplaceConverter.DoublePipeToNewLine}, UpdateSourceTrigger=PropertyChanged}" />
			<TextBlock FontStyle="Italic" Text="{x:Static p:Resources.PlaceEachSetOnASeparateLine}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
