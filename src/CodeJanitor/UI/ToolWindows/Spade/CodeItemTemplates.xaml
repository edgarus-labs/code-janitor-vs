<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ci="clr-namespace:CodeJanitor.Model.CodeItems"
	xmlns:p="clr-namespace:CodeJanitor.Properties"
	xmlns:cnv="clr-namespace:CodeJanitor.UI.Converters"
	xmlns:spade="clr-namespace:CodeJanitor.UI.ToolWindows.Spade">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="CodeItemBaseTemplates.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  Styles  -->
	<Style TargetType="{x:Type TextBlock}">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style
		x:Key="DefaultNameStyle"
		BasedOn="{StaticResource {x:Type TextBlock}}"
		TargetType="{x:Type TextBlock}" />

	<Style
		x:Key="ParentNameStyle"
		BasedOn="{StaticResource {x:Type TextBlock}}"
		TargetType="{x:Type TextBlock}">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style
		x:Key="NamespaceStyle"
		BasedOn="{StaticResource {x:Type TextBlock}}"
		TargetType="{x:Type TextBlock}">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontStyle" Value="Italic" />
		<Setter Property="Foreground" Value="#FF777777" />
	</Style>

	<Style
		x:Key="ComplexityStyle"
		BasedOn="{StaticResource {x:Type TextBlock}}"
		TargetType="{x:Type TextBlock}">
		<Setter Property="FontStyle" Value="Italic" />
		<Setter Property="Margin" Value="10,0,0,0" />
	</Style>

	<Style
		x:Key="MetadataStyle"
		BasedOn="{StaticResource {x:Type TextBlock}}"
		TargetType="{x:Type TextBlock}">
		<Setter Property="Foreground" Value="#FF777777" />
		<Setter Property="Margin" Value="10,0,0,0" />
	</Style>

	<!--  Common component templates  -->
	<DataTemplate x:Key="ComplexityDataTemplate">
		<ContentPresenter Content="{Binding Complexity}" ContentTemplate="{StaticResource ComplexityScoreDataTemplate}">
			<ContentPresenter.Resources>
				<Style BasedOn="{StaticResource ComplexityStyle}" TargetType="{x:Type TextBlock}" />
			</ContentPresenter.Resources>
		</ContentPresenter>
	</DataTemplate>

	<DataTemplate x:Key="ImageDataTemplate">
		<Image
			x:Name="image"
			Width="16"
			Height="16"
			Margin="0,0,4,0"
			Source="{Binding Converter={x:Static cnv:CodeItemToImageConverter.VS2012Light}}"
			UseLayoutRounding="True" />
		<DataTemplate.Triggers>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition Binding="{Binding DataContext.Package.IDEVersion, RelativeSource={RelativeSource FindAncestor, AncestorType=spade:SpadeView}, Converter={x:Static cnv:IsGreaterThanOrEqualToConverter.Default}, ConverterParameter=11}" Value="True" />
					<Condition Binding="{Binding DataContext.Package.ThemeManager.ActiveTheme, RelativeSource={RelativeSource FindAncestor, AncestorType=spade:SpadeView}}" Value="1" />
				</MultiDataTrigger.Conditions>
				<Setter TargetName="image" Property="Source" Value="{Binding Converter={x:Static cnv:CodeItemToImageConverter.VS2012Dark}}" />
			</MultiDataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="MetadataDataTemplate">
		<TextBlock
			x:Name="metadataTextBlock"
			Style="{StaticResource MetadataStyle}"
			Text="{Binding Converter={x:Static cnv:CodeItemToMetadataStringConverter.Default}}" />
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Digging_ShowItemMetadata, Source={x:Static p:Settings.Default}}" Value="False">
				<Setter Property="Visibility" Value="Collapsed" />
			</DataTrigger>
			<Trigger SourceName="metadataTextBlock" Property="Text" Value="">
				<Setter Property="Visibility" Value="Collapsed" />
			</Trigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="NameParametersDataTemplate">
		<ContentControl x:Name="name" Focusable="False">
			<MultiBinding Converter="{x:Static cnv:NameParametersToTextBlockConverter.Default}">
				<Binding />
				<Binding
					FallbackValue="{x:Null}"
					Path="DataContext.NameFilter"
					RelativeSource="{RelativeSource Mode=FindAncestor,
					                                AncestorType={x:Type spade:SpadeView}}" />
			</MultiBinding>
		</ContentControl>
	</DataTemplate>

	<DataTemplate x:Key="ParentNameDataTemplate">
		<ContentControl x:Name="name" Focusable="False">
			<MultiBinding Converter="{x:Static cnv:NameParametersToTextBlockConverter.Parent}">
				<Binding />
				<Binding
					FallbackValue="{x:Null}"
					Path="DataContext.NameFilter"
					RelativeSource="{RelativeSource Mode=FindAncestor,
					                                AncestorType={x:Type spade:SpadeView}}" />
			</MultiBinding>
		</ContentControl>
	</DataTemplate>

	<!--  CodeItem templates  -->
	<DataTemplate x:Key="DelegateDataTemplate" DataType="{x:Type ci:CodeItemDelegate}">
		<DockPanel x:Name="dockPanel" Margin="0,2">
			<ContentControl
				x:Name="metadata"
				Content="{Binding}"
				ContentTemplate="{StaticResource MetadataDataTemplate}"
				DockPanel.Dock="Right"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource ImageDataTemplate}"
				Focusable="False" />

			<ContentControl
				x:Name="nameParameters"
				Content="{Binding}"
				ContentTemplate="{StaticResource ParentNameDataTemplate}"
				Focusable="False" />

			<TextBlock
				x:Name="namespace"
				Style="{StaticResource NamespaceStyle}"
				Text="{Binding Namespace, StringFormat=' of {0}', FallbackValue='', TargetNullValue=''}" />
		</DockPanel>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem, AncestorLevel=2}, FallbackValue={x:Null}, Converter={x:Static cnv:NullToBooleanConverter.NotNull}}" Value="True">
				<Setter TargetName="dockPanel" Property="Margin" Value="0" />
				<Setter TargetName="nameParameters" Property="ContentTemplate" Value="{StaticResource NameParametersDataTemplate}" />
				<Setter TargetName="namespace" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<DataTemplate x:Key="MethodDataTemplate" DataType="{x:Type ci:CodeItemMethod}">
		<DockPanel>
			<ContentControl
				x:Name="complexity"
				Content="{Binding}"
				ContentTemplate="{StaticResource ComplexityDataTemplate}"
				DockPanel.Dock="Right"
				Focusable="False" />

			<ContentControl
				x:Name="metadata"
				Content="{Binding}"
				ContentTemplate="{StaticResource MetadataDataTemplate}"
				DockPanel.Dock="Right"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource ImageDataTemplate}"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource NameParametersDataTemplate}"
				Focusable="False" />
		</DockPanel>
	</DataTemplate>

	<HierarchicalDataTemplate
		x:Key="ParentDataTemplate"
		DataType="{x:Type ci:BaseCodeItemElementParent}"
		ItemsSource="{Binding Children}">
		<DockPanel x:Name="dockPanel" Margin="0,2">
			<ContentControl
				x:Name="metadata"
				Content="{Binding}"
				ContentTemplate="{StaticResource MetadataDataTemplate}"
				DockPanel.Dock="Right"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource ImageDataTemplate}"
				Focusable="False" />

			<ContentControl
				x:Name="name"
				Content="{Binding}"
				ContentTemplate="{StaticResource ParentNameDataTemplate}"
				Focusable="False" />

			<TextBlock
				x:Name="namespace"
				Style="{StaticResource NamespaceStyle}"
				Text="{Binding Namespace, StringFormat=' of {0}', FallbackValue='', TargetNullValue=''}" />
		</DockPanel>
		<HierarchicalDataTemplate.Triggers>
			<DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=TreeViewItem, AncestorLevel=2}, FallbackValue={x:Null}, Converter={x:Static cnv:NullToBooleanConverter.NotNull}}" Value="True">
				<Setter TargetName="dockPanel" Property="Margin" Value="0" />
				<Setter TargetName="name" Property="ContentTemplate" Value="{StaticResource NameParametersDataTemplate}" />
				<Setter TargetName="namespace" Property="Visibility" Value="Collapsed" />
			</DataTrigger>
		</HierarchicalDataTemplate.Triggers>
	</HierarchicalDataTemplate>

	<DataTemplate x:Key="PropertyDataTemplate" DataType="{x:Type ci:CodeItemProperty}">
		<DockPanel>
			<ContentControl
				x:Name="complexity"
				Content="{Binding}"
				ContentTemplate="{StaticResource ComplexityDataTemplate}"
				DockPanel.Dock="Right"
				Focusable="False" />

			<ContentControl
				x:Name="metadata"
				Content="{Binding}"
				ContentTemplate="{StaticResource MetadataDataTemplate}"
				DockPanel.Dock="Right"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource ImageDataTemplate}"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource NameParametersDataTemplate}"
				Focusable="False" />
		</DockPanel>
	</DataTemplate>

	<HierarchicalDataTemplate
		x:Key="RegionDataTemplate"
		DataType="{x:Type ci:CodeItemRegion}"
		ItemsSource="{Binding Children}">
		<DockPanel>
			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource ImageDataTemplate}"
				Focusable="False" />

			<TextBlock Style="{StaticResource DefaultNameStyle}" Text="{Binding Name}" />
		</DockPanel>
	</HierarchicalDataTemplate>

	<DataTemplate x:Key="StandardDataTemplate" DataType="{x:Type ci:BaseCodeItem}">
		<DockPanel>
			<ContentControl
				x:Name="metadata"
				Content="{Binding}"
				ContentTemplate="{StaticResource MetadataDataTemplate}"
				DockPanel.Dock="Right"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource ImageDataTemplate}"
				Focusable="False" />

			<ContentControl
				Content="{Binding}"
				ContentTemplate="{StaticResource NameParametersDataTemplate}"
				Focusable="False" />
		</DockPanel>
	</DataTemplate>
</ResourceDictionary>
