<platformUI:DialogWindow
	x:Class="CodeJanitor.UI.Dialogs.About.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
	Width="930"
	Height="424"
	HasDialogFrame="False"
	KeyDown="OnKeyDown"
	MouseLeftButtonDown="OnMouseLeftButtonDown"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	TextOptions.TextFormattingMode="Ideal"
	UseLayoutRounding="True"
	WindowStartupLocation="CenterScreen"
	WindowStyle="None">
	<platformUI:DialogWindow.Resources>
		<SolidColorBrush x:Key="AboutNavy" Color="#FF0B1633" />
		<SolidColorBrush x:Key="AboutText" Color="#FF4A5568" />
		<SolidColorBrush x:Key="AboutMuted" Color="#FF6B7280" />
		<SolidColorBrush x:Key="AboutLabel" Color="#FF111827" />
		<SolidColorBrush x:Key="AboutDivider" Color="#FFE2E8F0" />
		<SolidColorBrush x:Key="AboutAccent" Color="#FF1A73E8" />
		<LinearGradientBrush x:Key="AboutJanitorBrush" StartPoint="0,0" EndPoint="1,0">
			<GradientStop Offset="0" Color="#FF1668DC" />
			<GradientStop Offset="1" Color="#FF1E9BE8" />
		</LinearGradientBrush>

		<Style x:Key="FeatureLabel" TargetType="{x:Type TextBlock}">
			<Setter Property="Margin" Value="0,10,0,0" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="FontFamily" Value="Segoe UI" />
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="Foreground" Value="{StaticResource AboutLabel}" />
			<Setter Property="TextAlignment" Value="Center" />
		</Style>

		<Style x:Key="FeatureSeparator" TargetType="{x:Type Rectangle}">
			<Setter Property="Width" Value="1" />
			<Setter Property="Height" Value="44" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Fill" Value="{StaticResource AboutDivider}" />
		</Style>

		<Style x:Key="GitHubLinkButton" TargetType="{x:Type Button}">
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Foreground" Value="{StaticResource AboutMuted}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border Background="Transparent">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Foreground" Value="{StaticResource AboutAccent}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</platformUI:DialogWindow.Resources>

	<Border BorderBrush="{StaticResource AboutDivider}" BorderThickness="1">
		<Border.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
				<GradientStop Offset="0" Color="#FFFFFFFF" />
				<GradientStop Offset="0.55" Color="#FFFAFCFE" />
				<GradientStop Offset="1" Color="#FFF1F6FC" />
			</LinearGradientBrush>
		</Border.Background>

		<Grid ClipToBounds="True">
			<Canvas IsHitTestVisible="False">
				<Path Data="M -20,140 C 120,200 260,290 460,330 C 640,366 800,330 950,250 L 950,440 L -20,440 Z">
					<Path.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Offset="0" Color="#33CFE2F7" />
							<GradientStop Offset="1" Color="#00FFFFFF" />
						</LinearGradientBrush>
					</Path.Fill>
				</Path>
				<Path Data="M -20,220 C 140,280 300,350 520,360 C 700,368 840,320 950,280" StrokeThickness="1.5">
					<Path.Stroke>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Offset="0" Color="#40BBD5F2" />
							<GradientStop Offset="1" Color="#10BBD5F2" />
						</LinearGradientBrush>
					</Path.Stroke>
				</Path>
				<Path Data="M 700,-20 C 780,40 860,70 950,40 L 950,-20 Z">
					<Path.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
							<GradientStop Offset="0" Color="#00FFFFFF" />
							<GradientStop Offset="1" Color="#30CFE2F7" />
						</LinearGradientBrush>
					</Path.Fill>
				</Path>
				<Path Data="M 760,420 C 820,330 880,240 950,170 L 950,440 Z">
					<Path.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
							<GradientStop Offset="0" Color="#10CFE2F7" />
							<GradientStop Offset="1" Color="#40C4DBF5" />
						</LinearGradientBrush>
					</Path.Fill>
				</Path>
			</Canvas>

			<Image
				Width="214"
				Height="214"
				Margin="90,52,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				RenderOptions.BitmapScalingMode="HighQuality"
				Source="/Integration/Images/AboutLogo.png" />

			<Rectangle
				Width="1"
				Height="172"
				Margin="309,72,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Fill="{StaticResource AboutDivider}" />

			<StackPanel
				Width="560"
				Margin="340,62,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Top">
				<TextBlock
					FontFamily="Segoe UI"
					FontSize="63"
					FontWeight="Bold"
					LineHeight="66"
					LineStackingStrategy="BlockLineHeight">
					<Run Foreground="{StaticResource AboutNavy}" Text="Code" /><Run Foreground="{StaticResource AboutJanitorBrush}" Text="Janitor" />
				</TextBlock>
				<TextBlock
					x:Name="VersionTextBlock"
					Margin="2,4,0,0"
					FontFamily="Segoe UI"
					FontSize="19"
					Foreground="{StaticResource AboutText}" />
				<TextBlock
					Margin="2,2,0,0"
					FontFamily="Segoe UI"
					FontSize="19"
					Foreground="{StaticResource AboutText}">
					<Run Text="Keep your code clean. " /><Run
						FontWeight="SemiBold"
						Foreground="{StaticResource AboutAccent}"
						Text="Automatically." />
				</TextBlock>
				<TextBlock
					Width="425"
					Margin="2,18,0,0"
					HorizontalAlignment="Left"
					FontFamily="Segoe UI"
					FontSize="15.5"
					Foreground="{StaticResource AboutText}"
					LineHeight="22"
					LineStackingStrategy="BlockLineHeight"
					Text="A fork of CodeMaid, helping you fix issues, apply consistent code style and keep your solution clean."
					TextWrapping="Wrap" />
			</StackPanel>

			<Grid
				Margin="300,274,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Top">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="124" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="124" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="124" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="124" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Viewbox Width="32" Height="32">
						<Canvas Width="24" Height="24">
							<Path
								Data="M 11,2 C 11.7,7 14.5,9.8 19.5,10.5 C 14.5,11.2 11.7,14 11,19 C 10.3,14 7.5,11.2 2.5,10.5 C 7.5,9.8 10.3,7 11,2 Z"
								Stroke="#FF1E6FE0"
								StrokeLineJoin="Round"
								StrokeThickness="2" />
							<Path
								Data="M 19,16 L 19,22 M 16,19 L 22,19"
								Stroke="#FF1E6FE0"
								StrokeEndLineCap="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="2" />
						</Canvas>
					</Viewbox>
					<TextBlock Style="{StaticResource FeatureLabel}" Text="Fixes issues" />
				</StackPanel>

				<Rectangle Grid.Column="1" Style="{StaticResource FeatureSeparator}" />

				<StackPanel Grid.Column="2">
					<Viewbox Width="32" Height="32">
						<Canvas Width="24" Height="24">
							<Ellipse
								Canvas.Left="2.5"
								Canvas.Top="2.5"
								Width="19"
								Height="19"
								Stroke="#FF7C3AED"
								StrokeDashArray="1.05 0.9"
								StrokeThickness="3.2" />
							<Ellipse
								Canvas.Left="5"
								Canvas.Top="5"
								Width="14"
								Height="14"
								Stroke="#FF7C3AED"
								StrokeThickness="2" />
							<Ellipse
								Canvas.Left="9"
								Canvas.Top="9"
								Width="6"
								Height="6"
								Stroke="#FF7C3AED"
								StrokeThickness="2" />
						</Canvas>
					</Viewbox>
					<TextBlock Style="{StaticResource FeatureLabel}" Text="Follows&#x0a;.editorconfig" />
				</StackPanel>

				<Rectangle Grid.Column="3" Style="{StaticResource FeatureSeparator}" />

				<StackPanel Grid.Column="4">
					<Viewbox Width="32" Height="32">
						<Canvas Width="24" Height="24">
							<Path Data="M 12,1.5 L 20.5,4.8 L 20.5,11 C 20.5,16.3 16.9,20.7 12,22.5 C 7.1,20.7 3.5,16.3 3.5,11 L 3.5,4.8 Z" Fill="#FF10B981" />
							<Path Data="M 12,4.3 L 18,6.6 L 18,11.2 C 18,15 15.5,18.3 12,19.8 C 8.5,18.3 6,15 6,11.2 L 6,6.6 Z" Fill="#FFD1FAE5" />
							<Path
								Data="M 8.8,12 L 11.2,14.4 L 15.4,9.8"
								Stroke="#FF10B981"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="2.2" />
						</Canvas>
					</Viewbox>
					<TextBlock Style="{StaticResource FeatureLabel}" Text="Consistent&#x0a;code style" />
				</StackPanel>

				<Rectangle Grid.Column="5" Style="{StaticResource FeatureSeparator}" />

				<StackPanel Grid.Column="6">
					<Viewbox Width="32" Height="32">
						<Canvas Width="24" Height="24">
							<Path
								Data="M 7.5,6.5 L 2,12 L 7.5,17.5 M 16.5,6.5 L 22,12 L 16.5,17.5 M 13.8,3.5 L 10.2,20.5"
								Stroke="#FF1E6FE0"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="2.4" />
						</Canvas>
					</Viewbox>
					<TextBlock Style="{StaticResource FeatureLabel}" Text="Works in&#x0a;real time" />
				</StackPanel>
			</Grid>

			<Button
				Margin="34,0,0,22"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Click="OnGitHubLinkClick"
				Style="{StaticResource GitHubLinkButton}"
				ToolTip="https://github.com/edgarus-labs/code-janitor-vs">
				<StackPanel Orientation="Horizontal">
					<Viewbox Width="26" Height="26">
						<Path Data="M 8 0 C 3.58 0 0 3.58 0 8 c 0 3.54 2.29 6.53 5.47 7.59 .4 .07 .55 -.17 .55 -.38 0 -.19 -.01 -.82 -.01 -1.49 -2.01 .37 -2.53 -.49 -2.69 -.94 -.09 -.23 -.48 -.94 -.82 -1.13 -.28 -.15 -.68 -.52 -.01 -.53 .63 -.01 1.08 .58 1.23 .82 .72 1.21 1.87 .87 2.33 .66 .07 -.52 .28 -.87 .51 -1.07 -1.78 -.2 -3.64 -.89 -3.64 -3.95 0 -.87 .31 -1.59 .82 -2.15 -.08 -.2 -.36 -1.02 .08 -2.12 0 0 .67 -.21 2.2 .82 .64 -.18 1.32 -.27 2 -.27 .68 0 1.36 .09 2 .27 1.53 -1.04 2.2 -.82 2.2 -.82 .44 1.1 .16 1.92 .08 2.12 .51 .56 .82 1.27 .82 2.15 0 3.07 -1.87 3.75 -3.65 3.95 .29 .25 .54 .73 .54 1.48 0 1.07 -.01 1.93 -.01 2.2 0 .21 .15 .46 .55 .38 A 8.013 8.013 0 0 0 16 8 c 0 -4.42 -3.58 -8 -8 -8 z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
					</Viewbox>
					<TextBlock
						Margin="9,0,0,0"
						VerticalAlignment="Center"
						FontFamily="Segoe UI"
						FontSize="13"
						Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
						Text="Open Source on GitHub" />
				</StackPanel>
			</Button>

			<TextBlock
				x:Name="FooterVersionTextBlock"
				Margin="0,0,34,24"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				FontFamily="Segoe UI"
				FontSize="13"
				Foreground="{StaticResource AboutMuted}" />
		</Grid>
	</Border>
</platformUI:DialogWindow>
