<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:p="clr-namespace:CodeJanitor.Properties"
	xmlns:local="clr-namespace:CodeJanitor.UI.Dialogs.Options.Finding">
	<DataTemplate DataType="{x:Type local:FindingViewModel}">
		<StackPanel>
			<CheckBox Content="{x:Static p:Resources.ClearSolutionExplorerSearchFilteringToFindFilteredItems}" IsChecked="{Binding ClearSolutionExplorerSearch}" />
			<CheckBox Content="{x:Static p:Resources.TemporarilyOpenSolutionFoldersToFindNestedItems}" IsChecked="{Binding TemporarilyOpenSolutionFolders}" />
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
