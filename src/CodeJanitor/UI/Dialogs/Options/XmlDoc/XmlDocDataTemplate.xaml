<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ui="clr-namespace:CodeJanitor.UI"
	xmlns:local="clr-namespace:CodeJanitor.UI.Dialogs.Options.XmlDoc">
	<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	<DataTemplate DataType="{x:Type local:XmlDocViewModel}">
		<StackPanel>
			<GroupBox Header="AI Assistant &amp; LLM Provider Configuration">
				<StackPanel>
					<CheckBox
						Content="Enable AI-assisted features (XML Documentation, Test Generation, Refactor, Code Review)"
						IsChecked="{Binding AiXmlDocumentationEnabled}"
						ToolTip="Enables AI commands and documentation generation in Code Janitor." />

					<TextBlock
						Margin="0,10,0,4"
						FontWeight="Bold"
						Text="AI Backend Provider" />
					<StackPanel Margin="0,2,0,8" Orientation="Vertical">
						<RadioButton
							Margin="0,2,0,2"
							Content="Custom OpenAI-compatible API (Ollama, LM Studio, DeepSeek, Local LLM, Azure, OpenAI)"
							GroupName="AiProviderGroup"
							IsChecked="{Binding IsCustomProvider}" />
						<RadioButton
							Margin="0,2,0,2"
							Content="GitHub Copilot (Visual Studio Integrated / GitHub Token)"
							GroupName="AiProviderGroup"
							IsChecked="{Binding IsGitHubCopilotProvider}" />
					</StackPanel>

					<!--  GitHub Copilot Configuration Panel  -->
					<Border
						Margin="0,4,0,8"
						Padding="10"
						Background="#0D007ACC"
						BorderBrush="#33007ACC"
						BorderThickness="1"
						CornerRadius="3"
						Visibility="{Binding IsGitHubCopilotProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
						<StackPanel>
							<StackPanel Orientation="Horizontal">
								<TextBlock FontWeight="SemiBold" Text="Copilot Status: " />
								<TextBlock Text="{Binding CopilotStatusText}" TextWrapping="Wrap" />
							</StackPanel>
							<Button
								Margin="0,6,0,0"
								Padding="10,3"
								HorizontalAlignment="Left"
								Command="{Binding DetectCopilotCommand}"
								Content="Detect Active Copilot Connection / Fill Defaults" />
							<TextBlock Margin="0,8,0,2" Text="Copilot Model (Select from available models)" />
							<Grid Margin="0,2,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<ComboBox
									Grid.Column="0"
									IsEditable="False"
									ItemsSource="{Binding AvailableCopilotModels}"
									SelectedItem="{Binding CopilotModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								<Button
									Grid.Column="1"
									Margin="8,0,0,0"
									Padding="8,2"
									Command="{Binding FetchCopilotModelsCommand}"
									Content="Refresh Models"
									ToolTip="Query GitHub Copilot API for live available models" />
							</Grid>
							<TextBlock Margin="0,6,0,0" Text="GitHub Token / Copilot API Key (leave blank to use auto-detected local token)" />
							<PasswordBox ui:PasswordBoxAssistant.BindPassword="True" ui:PasswordBoxAssistant.BoundPassword="{Binding CopilotApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<TextBlock Margin="0,6,0,0" Text="Endpoint URL (default: https://api.githubcopilot.com/chat/completions)" />
							<TextBox Text="{Binding CopilotEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />
						</StackPanel>
					</Border>

					<!--  Custom OpenAI-compatible Configuration Panel  -->
					<StackPanel Visibility="{Binding IsCustomProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
						<TextBlock Margin="0,6,0,0" Text="Endpoint URL" />
						<TextBox Text="{Binding CustomEndpointUrl, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock Margin="0,6,0,0" Text="API key" />
						<PasswordBox ui:PasswordBoxAssistant.BindPassword="True" ui:PasswordBoxAssistant.BoundPassword="{Binding CustomApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock Margin="0,6,0,0" Text="API key header (Authorization / api-key / x-api-key)" />
						<TextBox Text="{Binding CustomApiKeyHeader, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock Margin="0,6,0,0" Text="Model or deployment name (optional)" />
						<TextBox Text="{Binding CustomModel, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>

					<StackPanel Margin="0,8,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Timeout (seconds)" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Max methods/file" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxMethodsPerFile, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<Button
							Margin="12,0,0,0"
							Padding="10,2"
							Command="{Binding TestAiApiConnectionCommand}"
							Content="Test API Connection"
							ToolTip="Checks that the endpoint is reachable and the API key is accepted, independent of the model name." />
						<Button
							Margin="6,0,0,0"
							Padding="10,2"
							Command="{Binding TestAiModelCommand}"
							Content="Test Model"
							ToolTip="Sends a simple probe prompt to the configured model and checks that a valid response comes back." />
					</StackPanel>

					<TextBlock
						Margin="0,4,0,0"
						FontStyle="Italic"
						Text="{Binding AiXmlDocumentationConnectionStatus}"
						TextWrapping="Wrap" />

					<StackPanel Margin="0,6,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Max parallel files" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxParallelFiles, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right"
							ToolTip="Number of files processed concurrently during Add XMLDoc (default 4)." />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Minimum context window (tokens)"
							ToolTip="Recommended context size for the model to reliably process a full method's context (default 131072). For local endpoints (e.g. Ollama, llama.cpp), the actual context size must usually still be configured on the server itself (e.g. Ollama Modelfile 'PARAMETER num_ctx'); the OpenAI-compatible chat API does not let clients set it directly." />
						<TextBox
							Width="64"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationContextWindowTokens, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
					</StackPanel>

					<CheckBox
						Margin="0,8,0,0"
						Content="Preview AI XMLDoc changes before applying per file"
						IsChecked="{Binding AiXmlDocumentationPreviewChanges}" />
					<CheckBox Content="Allow deterministic fallback when AI response fails" IsChecked="{Binding AiXmlDocumentationAllowDeterministicFallback}" />

					<StackPanel Margin="0,6,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Max requests/run" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxRequestsPerCleanup, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Max input chars/method" />
						<TextBox
							Width="64"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxInputCharsPerMethod, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
					</StackPanel>

					<StackPanel Margin="0,6,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Max output tokens/request" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxTokensPerRequest, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Max estimated tokens/run" />
						<TextBox
							Width="64"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationMaxEstimatedTokensPerCleanup, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Text="Global timeout (s)" />
						<TextBox
							Width="48"
							Margin="8,0,0,0"
							Text="{Binding AiXmlDocumentationGlobalTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
							TextAlignment="Right" />
					</StackPanel>

					<CheckBox
						Margin="0,8,0,0"
						Content="Ignore [GeneratedCode]/[CompilerGenerated] methods"
						IsChecked="{Binding AiXmlDocumentationIgnoreGeneratedCode}" />
					<CheckBox Content="Ignore [Obsolete] methods" IsChecked="{Binding AiXmlDocumentationIgnoreObsolete}" />
					<CheckBox Content="Ignore unit test methods (Fact/Theory/TestMethod/etc.)" IsChecked="{Binding AiXmlDocumentationIgnoreTestMethods}" />
					<TextBlock Margin="0,6,0,0" Text="Ignore regex (full member path Namespace.Type.Method)" />
					<TextBox Text="{Binding AiXmlDocumentationIgnorePattern, UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>
			</GroupBox>
			<GroupBox Margin="0,8,0,0" Header="AI Unit Test Generation">
				<StackPanel>
					<StackPanel Margin="0,4,0,0" Orientation="Horizontal">
						<TextBlock VerticalAlignment="Center" Text="Test Framework (xUnit / NUnit / MSTest)" />
						<TextBox
							Width="80"
							Margin="8,0,0,0"
							Text="{Binding AiTestFramework, UpdateSourceTrigger=PropertyChanged}" />
						<TextBlock
							Margin="16,0,0,0"
							VerticalAlignment="Center"
							Text="Mocking Library (Moq / NSubstitute)" />
						<TextBox
							Width="80"
							Margin="8,0,0,0"
							Text="{Binding AiMockingLibrary, UpdateSourceTrigger=PropertyChanged}" />
					</StackPanel>
				</StackPanel>
			</GroupBox>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
