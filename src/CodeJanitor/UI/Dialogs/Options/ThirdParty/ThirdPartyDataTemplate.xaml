<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:p="clr-namespace:CodeJanitor.Properties"
	xmlns:cnv="clr-namespace:CodeJanitor.UI.Converters"
	xmlns:local="clr-namespace:CodeJanitor.UI.Dialogs.Options.ThirdParty">
	<DataTemplate DataType="{x:Type local:ThirdPartyViewModel}">
		<StackPanel>
			<GroupBox Header="{x:Static p:Resources.WhileCleaning}">
				<StackPanel>
					<CheckBox
						Content="{x:Static p:Resources.RunJetBrainsReSharperCleanup}"
						IsChecked="{Binding UseJetBrainsReSharperCleanup}"
						IsEnabled="{Binding IsEnabledUseJetBrainsReSharperCleanup}" />
					<CheckBox
						Content="{x:Static p:Resources.RunTelerikJustCodeCleanup}"
						IsChecked="{Binding UseTelerikJustCodeCleanup}"
						IsEnabled="{Binding IsEnabledUseTelerikJustCodeCleanup}" />
					<CheckBox
						Content="{x:Static p:Resources.RunXAMLStylerCleanup}"
						IsChecked="{Binding UseXAMLStylerCleanup}"
						IsEnabled="{Binding IsEnabledUseXAMLStylerCleanup}" />

					<TextBlock Margin="5,5,5,0" Text="{x:Static p:Resources.OtherCleaningCommandsExReSharperReSharper_SilentCleanupCode}" />
					<TextBox Style="{DynamicResource TextBoxMultiLine}" Text="{Binding OtherCleaningCommandsExpression, Converter={x:Static cnv:StringReplaceConverter.DoublePipeToNewLine}, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock FontStyle="Italic" Text="{x:Static p:Resources.PlaceEachCommandOnASeparateLine}" />
				</StackPanel>
			</GroupBox>
		</StackPanel>
	</DataTemplate>
</ResourceDictionary>
