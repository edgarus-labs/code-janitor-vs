<platformUI:DialogWindow
	x:Class="CodeJanitor.UI.Dialogs.CleanupOptions.CleanupPreviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
	xmlns:ui="clr-namespace:CodeJanitor.UI"
	Title="C# Text Cleanup Preview"
	Width="1100" Height="760" MinWidth="700" MinHeight="480"
	ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
	ui:WindowAttachedProperties.DialogResult="{Binding DialogResult}">
	<platformUI:DialogWindow.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/UI/Themes/CodeJanitorCoreTheme.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</platformUI:DialogWindow.Resources>
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="150" MinHeight="80" />
			<RowDefinition Height="5" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
			AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
			SelectionMode="Single" HeadersVisibility="Column">
			<DataGrid.Columns>
				<DataGridTemplateColumn Header="Apply" Width="50">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
								IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
								IsEnabled="{Binding CanApply}" ToolTip="Include file" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn Header="File" Binding="{Binding Path}" Width="2*" IsReadOnly="True" />
				<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True" />
			</DataGrid.Columns>
		</DataGrid>
		<GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="5" />
		<TabControl Grid.Row="2" Margin="0,4,0,8">
			<TabItem Header="Changes">
				<Grid>
					<ContentControl x:Name="DifferenceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
					<Grid x:Name="TextFallback">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="5" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<DockPanel>
						<TextBlock DockPanel.Dock="Top" Text="Before" Margin="6" />
						<TextBox Text="{Binding SelectedFile.OriginalSource, Mode=OneWay}" IsReadOnly="True"
							FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
					</DockPanel>
					<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
					<DockPanel Grid.Column="2">
						<TextBlock DockPanel.Dock="Top" Text="After" Margin="6" />
						<TextBox Text="{Binding SelectedFile.UpdatedSource, Mode=OneWay}" IsReadOnly="True"
							FontFamily="Consolas" FontSize="12" HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
					</DockPanel>
					</Grid>
				</Grid>
			</TabItem>
			<TabItem Header="Rules">
				<DataGrid ItemsSource="{Binding SelectedFile.Rules}" AutoGenerateColumns="False"
					CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
					<DataGrid.Columns>
						<DataGridTemplateColumn Header="Include" Width="60">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
										IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" ToolTip="Include rule" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Rule" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
						<DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="*" IsReadOnly="True" />
					</DataGrid.Columns>
				</DataGrid>
			</TabItem>
		</TabControl>
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="_Apply to Editors" Command="{Binding ApplyCommand}" Style="{StaticResource ButtonDialog}" MinWidth="140" />
			<Button Content="_Cancel" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource ButtonDialog}" />
		</StackPanel>
	</Grid>
</platformUI:DialogWindow>