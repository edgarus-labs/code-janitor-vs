<Window
	x:Class="CodeJanitor.UI.Dialogs.Ai.AiCoverageProgressDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="AI Code Coverage Progress"
	Width="520"
	Height="260"
	MinWidth="450"
	MinHeight="230"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner">
	<Grid Background="#F8F9FA">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<Border
			Grid.Row="0"
			Padding="16,10"
			Background="#007ACC"
			BorderBrush="#005A9E"
			BorderThickness="0,0,0,1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock
						FontSize="14"
						FontWeight="Bold"
						Foreground="White"
						Text="⚡ Generating Tests to Reach Target Coverage" />
					<TextBlock
						Margin="0,2,0,0"
						FontSize="11"
						FontStyle="Italic"
						Foreground="#D0E8FF"
						Text="{Binding TargetName}" />
				</StackPanel>
				<Border
					Grid.Column="1"
					Padding="8,3"
					Background="#005A9E"
					CornerRadius="4">
					<TextBlock
						FontSize="11"
						FontWeight="Bold"
						Foreground="White"
						Text="{Binding TargetCoveragePercentage, StringFormat='Goal: {0}%'}" />
				</Border>
			</Grid>
		</Border>

		<!--  Progress Body  -->
		<StackPanel Grid.Row="1" Margin="20,16,20,10">
			<Grid Margin="0,0,0,4">
				<TextBlock
					FontWeight="SemiBold"
					Foreground="#24292F"
					Text="{Binding IterationText}" />
				<TextBlock
					HorizontalAlignment="Right"
					FontWeight="Bold"
					Foreground="#007ACC"
					Text="{Binding CurrentCoveragePercentage, StringFormat='Coverage: {0}%'}" />
			</Grid>

			<ProgressBar
				Height="18"
				Margin="0,4,0,10"
				Foreground="#007ACC"
				Maximum="{Binding TargetCoveragePercentage}"
				Minimum="0"
				Value="{Binding CurrentCoveragePercentage}" />

			<TextBlock
				FontSize="12"
				FontStyle="Italic"
				Foreground="#57606A"
				Text="{Binding StatusMessage}"
				TextWrapping="Wrap" />
		</StackPanel>

		<!--  Actions  -->
		<Border
			Grid.Row="2"
			Padding="16,10"
			Background="#ECEFF1"
			BorderBrush="#CFD8DC"
			BorderThickness="0,1,0,0">
			<Button
				Width="100"
				Height="28"
				HorizontalAlignment="Right"
				Command="{Binding CancelCommand}"
				Content="Cancel"
				IsCancel="True" />
		</Border>
	</Grid>
</Window>
